# Для разработки этот файл не нужен: всё работает со значениями по умолчанию.
# Сервер сам читает файл apps/server/.env, если он есть.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Адреса веб-приложения, которым разрешено обращаться к серверу, через запятую
CORS_ORIGINS=http://localhost:8081

# База данных. Не задано — встроенная база в папке EMBEDDED_DB_DIR
# DATABASE_URL=postgres://user:password@localhost:5432/rooms
EMBEDDED_DB_DIR=.data/pglite

# Обязательны в продакшене. Сгенерировать: openssl rand -base64 32
# EMAIL_HASH_KEY=
# EMAIL_ENCRYPTION_KEY=

# Только для разработки (в продакшене запрещены)
# DEV_EXPOSE_LOGIN_CODES=true
# DEV_SEED_INVITE_CODE=TEST-2026

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# Ключ каталога GIF gifs.ru (кабинет: https://api.gifs.ru/portal). Без него окно GIF отвечает «недоступно»,
# а при разработке показывает тестовые плитки. Настоящий ключ вписывать только в файл .env (он в git не попадает)
# GIFS_RU_API_KEY=
# Сколько запросов GIF в минуту можно одному человеку
# GIFS_RATE_LIMIT_PER_MINUTE=90

# Почты админов через запятую. В продакшене без этой настройки админов нет
# ADMIN_EMAILS=first@example.com,second@example.com
