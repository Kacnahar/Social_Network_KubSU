# Для разработки этот файл не нужен: всё работает со значениями по умолчанию.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Адреса веб-приложения, которым разрешено обращаться к серверу, через запятую
CORS_ORIGINS=http://localhost:8081

# База данных. Не задано — встроенная база в папке EMBEDDED_DB_DIR
# DATABASE_URL=postgres://user:password@localhost:5432/rooms
EMBEDDED_DB_DIR=.data/pglite

# Обязательны в продакшене. Сгенерировать: openssl rand -base64 32
# EMAIL_HASH_KEY=
# EMAIL_ENCRYPTION_KEY=

# Только для разработки (в продакшене запрещены)
# DEV_EXPOSE_LOGIN_CODES=true
# DEV_SEED_INVITE_CODE=TEST-2026

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
