{
  "name": "social-network",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @app/server dev",
    "dev:web": "pnpm --filter @app/mobile web",
    "dev:mobile": "pnpm --filter @app/mobile start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test"
  }
}
